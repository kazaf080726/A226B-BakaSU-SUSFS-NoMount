/KernelSU/
/NoMount/
/toolchain
/out/
/out-*/
/dist/
/.kpm-tools/
/pathmask/src/*.ko
/pathmask/src/*.o
/pathmask/src/.*.cmd
/pathmask/src/*.mod
/pathmask/src/*.mod.c
/pathmask/src/Module.symvers
/pathmask/src/modules.order
/pathmask/ksu-module/*.ko
/include/generated/
/arch/arm64/include/generated/
/arch/arm/include/generated/
*.rej
*.orig

# kbuild host tools and command records regenerated on every build: committing
# them both pollutes the tree and (because the build rewrites them) makes git
# report a dirty tree, which appends a "+" to the kernel release string.
/scripts/basic/fixdep
/scripts/basic/bin2c
/scripts/unifdef
/scripts/.*.cmd
/scripts/basic/.*.cmd
/.tmp_versions/
/pathmask/src/.tmp_versions/
